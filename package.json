{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "build": "corepack pnpm run typecheck && corepack pnpm --filter @workspace/api-server --filter @workspace/crits-shop run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:shop": "corepack pnpm --filter @workspace/crits-shop run dev",
    "dev:api": "corepack pnpm --filter @workspace/api-server run dev",
    "db:generate": "corepack pnpm --filter @workspace/db run generate",
    "db:migrate": "corepack pnpm --filter @workspace/db run migrate",
    "preflight:deploy": "node --env-file-if-exists=.env.production ./scripts/deploy-preflight.mjs",
    "catalogue:import-jiji": "node --env-file-if-exists=.env.local ./scripts/import-jiji-crits.mjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
