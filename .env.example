# Copy to .env.local and set private values. .env.local is excluded from Git.
POSTGRES_PORT=5433
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CRITS_DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
DATABASE_URL=postgresql://crits_app:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5433/crits_db
PORT=8080
WEB_PORT=25380
API_HOST=127.0.0.1
WEB_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://127.0.0.1:25380

# Keep product uploads on local persistent disk. Use a managed object store in production.
MEDIA_DIR=var/product-images
MEDIA_UPLOAD_SIGNING_KEY=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET

# Clerk development instance values. The publishable key is public; the secret key is server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# One or more approved Clerk user IDs, comma separated. Emails are not accepted here.
CRITS_ADMIN_USER_IDS=

# Optional WhatsApp contact override; leaving it unset uses the supplied CRITS number.
# VITE_CRITS_WHATSAPP=
