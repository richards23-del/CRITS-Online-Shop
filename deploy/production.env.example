# Copy to .env.production and keep it out of Git. Use a secret manager when available.
# DOMAIN must match APP_ORIGIN and must resolve to this server.
DOMAIN=shop.example.com
APP_ORIGIN=https://shop.example.com
TRUST_PROXY_HOPS=1
MEDIA_DIR=/var/lib/crits/media

# Use the provider's private, TLS-enabled connection string. Add sslmode=verify-full
# or sslmode=require according to the database provider's documented settings.
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DATABASE_HOST:5432/crits_db?sslmode=verify-full

# Use keys from the Clerk Production instance. Public key is embedded into the storefront.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_PRODUCTION_PUBLISHABLE_KEY
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_PRODUCTION_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_SECRET_KEY
CRITS_ADMIN_USER_IDS=user_REPLACE_WITH_PRODUCTION_STAFF_ID

# Generate a unique random value of 32 bytes or more.
MEDIA_UPLOAD_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Encrypted off-host backups (required by the production preflight).
# Use a private remote repository. Keep this password in the host secret manager where possible.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/REPLACE_WITH_PRIVATE_BUCKET/crits-online-shop
RESTIC_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_32_BYTES_OR_MORE
CRITS_BACKUP_HOST=crits-production
# Set AWS credentials in the host secret manager or environment when the selected S3-compatible
# repository requires them. Do not use the same secret as RESTIC_PASSWORD.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
